# =============================================================================
# BackHaul — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# NEVER commit `.env.local` or any file containing real secrets.
# =============================================================================

# --- Supabase --------------------------------------------------------------
# Found in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER-SIDE ONLY. Never expose to the browser/client
# bundle. Used only in trusted server contexts (e.g. admin API routes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Maps / Geocoding (optional) --------------------------------------------
# The app ships with a fully-functional mock MapProvider that requires no
# API key (see lib/maps/mock-provider.ts). Set these only if you implement
# and wire up a real provider (Google Maps, Mapbox, OpenRouteService, ...).
MAPS_PROVIDER=mock
# MAPS_API_KEY=

# --- Payments (Demo/Mock only in MVP) ---------------------------------------
PAYMENT_PROVIDER=mock

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BackHaul
